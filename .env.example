# Postgres do Neon — projeto novo e separado do badnews e do meuportifoliougc
DATABASE_URL=postgresql://usuario:senha@host.neon.tech/neondb?sslmode=require

# segredo que assina o cookie de login — string longa e aleatória, diferente em cada ambiente
JWT_SECRET=troque-por-uma-string-longa-e-aleatoria

# Brevo SMTP — mesma conta já usada pelo badnews, remetente próprio deste admin
# EMAIL_FROM precisa estar verificado como "sender" no painel do Brevo (Settings → Senders)
# antes de funcionar — sem domínio próprio, é feita por confirmação de email (single sender).
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=troque-pelo-login-brevo
SMTP_PASS=troque-pela-chave-brevo
EMAIL_FROM=ugc.admin.templates@gmail.com

# URL pública deste admin — usada para montar o link de reset de senha nos emails
APP_URL=http://localhost:8888
